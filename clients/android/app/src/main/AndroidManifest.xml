<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TrajectoryApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/stat_sys_warning"
        android:label="Trajectory"
        android:roundIcon="@android:drawable/stat_sys_warning"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrajectoryMobile">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Trajectory">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TrajectoryVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
