{
  "name": "@trajectory/desktop",
  "version": "0.1.22",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "sidecar:stage": "bash scripts/stage-sidecar.sh",
    "tauri": "tauri",
    "tauri:build": "npm run sidecar:stage && tauri build",
    "tauri:check": "npm run sidecar:stage && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  }
}
