[Unit]
Description=Trajectory high-throughput DNS tunnel server
After=network-online.target
Wants=network-online.target
Conflicts=systemd-resolved.service

[Service]
Type=simple
WorkingDirectory=/opt/trajectory
ExecStart=/opt/trajectory/trajectory-server --dns-listen-port 53 --target-address 127.0.0.1:22 --domain t.7-b.cc --cert /opt/trajectory/certs/cert.pem --key /opt/trajectory/certs/key.pem
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
